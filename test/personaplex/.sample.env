# mstar personaplex (PersonaPlex-7B) test config — copy to .env and edit:
#   cp test/personaplex/.sample.env test/personaplex/.env
# The checkpoint is gated: accept NVIDIA's license on Hugging Face and log in
# (`huggingface-cli login`) or export HF_TOKEN before launching.

# --- User identity (used for temp paths) ---
WHO=yourname

# --- GPU device (single GPU: configs/personaplex.yaml puts every node on rank 0) ---
DEVICES=0

# --- Server host/port ---
HOST=127.0.0.1
PORT=8000

# --- Weight cache directory (HF snapshots and the extracted voices/ land here) ---
PERSONAPLEX_CACHE_DIR=/mnt/storage/$WHO/mstar/personaplex/

# --- Tensor transfer protocol (SHM is the safe single-node default) ---
TENSOR_PROTOCOL=SHM

# --- TCP loopback device (only used when TENSOR_PROTOCOL=TCP) ---
TCP_DEVICE=0.0.0.0.0
